# Required: API credential for the configured OpenAI-compatible provider
API_KEY=
# Optional: defaults to https://api.openai.com/v1
BASE_URL=https://api.openai.com/v1
# Optional: defaults to the configured model
MODEL=gpt-5.6-luna

REASONING_EFFORT=medium

# Optional: compaction check interval in turns; defaults to 25
COMPACTION_TURN_THRESHOLD=40
